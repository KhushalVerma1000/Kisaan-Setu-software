generator client {
  provider        = "prisma-client"
  output          = "../../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// PUBLIC SCHEMA — your application schema. This is the schema you own and
// want to keep portable, so:
//   1. IDs default to `uuid(7)`, generated client-side by Prisma rather than
//      by a Postgres-specific SQL function. Time-ordered, index-friendly,
//      and won't depend on any DB extension if you ever change providers.
//   2. No table in this schema holds a foreign key into `auth`. Everything
//      that used to reference `auth.users` now references `users`
//      below, so this whole schema could be pointed at a different
//      Postgres instance (or exported/restored independently) without
//      dragging Supabase's auth tables along with it.
// =========================================================================

/// The real users table — mid-migration from Supabase Auth to Auth.js.
///
/// TRANSITIONAL STATE: while Supabase Auth is still handling signup/login,
/// this table is kept in sync via a Postgres trigger on auth.users (below).
/// Once Auth.js's signup/login routes go live, they write here directly —
/// password_hash, email_verified_at etc. are populated by the app, not
/// mirrored from anywhere — and the trigger + the shadow-sync framing can
/// be retired. This model was never Prisma-related to auth.users (no FK),
/// so that cutover doesn't touch anything else in this schema.
///
/// Trigger, for the transitional period only:
///
///   create function public.handle_new_auth_user()
///   returns trigger as $$
///   begin
///     insert into public.users (id, created_at, email, fpo_name)
///     values (new.id, new.created_at, new.email, new.raw_user_meta_data->>'FPOname');
///     return new;
///   end;
///   $$ language plpgsql security definer;
///
///   create trigger on_auth_user_created
///     after insert on auth.users
///     for each row execute procedure public.handle_new_auth_user();
///
/// password_hash / email_verified_at / reset_token / reset_token_expires_at
/// are NOT populated by this trigger — those get backfilled once, from the
/// one-time auth data migration script, and from then on are owned by
/// Auth.js's own signup/reset flows.
model users {
  id                     String                   @id @default(uuid(7)) @db.Uuid
  email                  String?                  @unique @db.VarChar(255)
  fpo_name               String?
  password_hash          String?
  email_verified_at      DateTime?                @db.Timestamptz(6)
  reset_token            String?
  reset_token_expires_at DateTime?                @db.Timestamptz(6)
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  active_transactions    active_transactions[]
  bank_details           bank_details[]
  categories             categories[]
  fpo_profiles           fpo_profiles?
  inventory_transactions inventory_transactions[]
  items                  items[]
  purchase_orders        purchase_orders[]
  purchase_vouchers      purchase_vouchers[]
  quotations             quotations[]
  taxes                  taxes[]
  units                  units[]
  user_plans             user_plans[]
}

/// Catalog of subscription plans (e.g. one-year, three-year). A row here per
/// offering, not per customer — new tiers or price changes are just new/
/// updated rows, never a schema migration.
model plans {
  id            String       @id @default(uuid(7)) @db.Uuid
  code          String       @unique @db.VarChar(50)
  name          String       @db.VarChar(100)
  duration_days Int
  price         Decimal?     @db.Decimal(10, 2)
  is_active     Boolean      @default(true)
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?    @default(now()) @db.Timestamptz(6)
  user_plans    user_plans[]
}

/// One row per plan purchase/renewal/assignment for a user — history, not a
/// single mutable "current plan" field. Current plan is whichever row has
/// the latest started_at (or expires_at > now() and cancelled_at is null).
model user_plans {
  id                String    @id @default(uuid(7)) @db.Uuid
  user_id           String    @db.Uuid
  plan_id           String    @db.Uuid
  started_at        DateTime  @default(now()) @db.Timestamptz(6)
  expires_at        DateTime  @db.Timestamptz(6)
  cancelled_at      DateTime? @db.Timestamptz(6)
  payment_reference String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plans             plans     @relation(fields: [plan_id], references: [id])

  @@index([user_id])
  @@index([expires_at])
}

