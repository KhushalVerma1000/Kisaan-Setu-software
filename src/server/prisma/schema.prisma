model tax_configuration {
  id                String        @id @default(uuid(7)) @db.Uuid
  ledger_account_id String        @unique @db.Uuid
  tax_type          tax_type
  direction         tax_direction
  rate              Decimal?      @db.Decimal(5, 2)
  fpo_id            String?       @db.Uuid
  created_at        DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?     @default(now()) @db.Timestamptz(6)

  ledger_account ledger_account @relation(fields: [ledger_account_id], references: [id], onDelete: Cascade)
  fpo_profiles   fpo_profiles?  @relation(fields: [fpo_id], references: [id], onDelete: Cascade)

  @@unique([fpo_id, tax_type, direction], map: "uk_tax_configuration_fpo_type_direction")
  @@index([fpo_id], map: "idx_tax_configuration_fpo")
}

enum tax_type {
  CGST
  SGST
  IGST
  CESS
  TDS
  TCS
}

enum tax_direction {
  output // GST collected on sales — a liability
  input // GST paid on purchases, claimable back — an asset
  payable // TDS/TCS you owe to the government — a liability
  receivable // TDS deducted by others on your income — an asset
}

model party {
  id                String     @id @default(uuid(7)) @db.Uuid
  ledger_account_id String     @unique @db.Uuid
  party_type        party_type
  phone_number      String?    @db.VarChar(20)
  address           String?
  gst_number        String?    @db.VarChar(15)
  state             String?    @db.VarChar(100)
  opening_date      DateTime?  @db.Date
  fpo_id            String?    @db.Uuid
  created_at        DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?  @default(now()) @db.Timestamptz(6)

  ledger_account ledger_account @relation(fields: [ledger_account_id], references: [id], onDelete: Cascade)
  fpo_profiles   fpo_profiles?  @relation(fields: [fpo_id], references: [id], onDelete: Cascade)

  @@index([fpo_id], map: "idx_party_fpo")
  @@index([gst_number], map: "idx_party_gst_number")
  @@index([state], map: "idx_party_state")
